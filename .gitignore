*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
pip-wheel-metadata/
*.dist-info/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
venv-bridge/

