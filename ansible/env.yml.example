# Example Ansible environment file for mcp-rhel-manager
# Replace placeholders with real values or use the interactive configure script:
#   python3 scripts/configure_ansible_env.py

mcp_rhel_manager:
  # Password used by playbooks that reference {{ user_password }}
  user_password: "<YOUR_PASSWORD_HERE>"

# Top-level compatibility key (optional)
user_password: "<YOUR_PASSWORD_HERE>"

# Monitoring role variables (optional)
monitoring:
  grafana_admin_user: "admin"
  grafana_admin_password: "<YOUR_GRAFANA_ADMIN_PASSWORD>"
