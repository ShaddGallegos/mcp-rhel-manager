<?xml version="1.0"?>
<!DOCTYPE source SYSTEM "source.dtd">
<source>
    <name>Twitter</name>
    <keys>
        <key>
            <name>API key</name>
            <value>api_key</value>
        </key>
        <key>
            <name>API secret</name>
            <value>api_secret</value>
        </key>
        <key>
            <name>Access token</name>
            <value>access_token</value>
        </key>
        <key>
            <name>Access token secret</name>
            <value>access_token_secret</value>
        </key>
    </keys>
    <children>
        <node>
            <name>Search</name>
            <description>Search's tweets</description>
            <function>search</function>
            <inputs>
                <input required="true">
                    <name>Query</name>
                    <type>primary</type>
                </input>
                <input>
                    <name>Arguments</name>
                    <type>arguments</type>
                </input>
            </inputs>
        </node>
        <node>
            <name>User</name>
            <description>User's tweets</description>
            <function>user</function>
            <inputs>
                <input required="true">
                    <name>User</name>
                    <type>primary</type>
                </input>
            </inputs>
        </node>
    </children>
</source>
