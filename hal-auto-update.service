[Unit]
Description=HAL Auto-Update Service (DNF, Flatpak, SELinux, Firewall)
Documentation=file://<REPO_ROOT>/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=<REPO_ROOT>/scripts/hal-auto-update.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hal-auto-update

# Security hardening
PrivateTmp=no
NoNewPrivileges=no
ProtectSystem=no
ProtectHome=no

# Retry logic
RemainAfterExit=no
