# Example environment file for the approvals service.
# Install system-wide at /etc/mcp-ai/approvals.env or per-user at ~/.config/mcp/approvals.env
# Set certificate and key paths (PEM). If both are set, TLS will be enabled.
APPROVALS_CERTFILE=/etc/mcp-ai/approvals.crt
APPROVALS_KEYFILE=/etc/mcp-ai/approvals.key
# Optional overrides:
# APPROVALS_HOST=127.0.0.1
# APPROVALS_PORT=8443
