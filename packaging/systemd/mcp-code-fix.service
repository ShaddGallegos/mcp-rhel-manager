[Unit]
Description=MCP Code Fix Runner (oneshot)
After=network.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/mcp-code-fix
ExecStart=/usr/local/bin/scan_and_fix_git_dirs.sh
Nice=10
TimeoutStartSec=600
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths=/var/lib/mcp-llms /etc/mcp-ai /var/log/mcp-code-fix /tmp

[Install]
WantedBy=multi-user.target
