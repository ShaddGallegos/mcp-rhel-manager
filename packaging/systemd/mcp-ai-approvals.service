[Unit]
Description=MCP AI Approvals API
After=network.target

[Service]
Type=simple
User=mcp
WorkingDirectory=/opt/mcp-rhel-manager
ExecStart=/opt/mcp-rhel-manager/venv/bin/python /opt/mcp-rhel-manager/mcp-ai/approvals_api.py --host 127.0.0.1 --port 8001
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
