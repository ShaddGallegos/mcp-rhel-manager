#!/bin/bash
# ==============================================================================
# UNIFIED AGNOSTIC MCP DEPLOYER (RHEL 10 / FEDORA)
# Target: ThinkPad P17 Gen 2i | User: sgallego
# ==============================================================================

set -e

BASE_DIR="/home/sgallego/mcp-rhel-manager"
SEED_DIR="/home/sgallego/.local/share/mcp-seed"
VENV_DIR="$BASE_DIR/venv"
BRIDGE_VENV="$BASE_DIR/venv-bridge"
LOG_FILE="$BASE_DIR/sentinel.log"

echo "🧹 Phase 1: Cleaning legacy environment..."
# Stop old services if they exist
systemctl --user stop mcp-ai-mechanic.service mcp-bridge.service 2>/dev/null || true
# Unlock seed for cleanup if it exists
sudo chattr -i "$SEED_DIR/server.py.gold" 2>/dev/null || true
# Wipe old files but keep the directory
mkdir -p "$BASE_DIR"
find "$BASE_DIR" -maxdepth 1 -type f -not -name 'unify_mcp.sh' -delete

echo "📦 Phase 2: Building Agnostic Python Environments..."
python3 -m venv "$VENV_DIR"
"$VENV_DIR/bin/pip" install mcp[cli] fastmcp psutil

python3 -m venv "$BRIDGE_VENV"
"$BRIDGE_VENV/bin/pip" install ollama-mcp-bridge

echo "🧠 Phase 3: Creating the Unified Agnostic server.py..."
cat << 'EOF' > "$BASE_DIR/server.py"
import sys, os, subprocess, psutil
from mcp.server.fastmcp import FastMCP

mcp = FastMCP("RHEL-Fedora-Agnostic-Manager")

def run_sys_cmd(cmd, sudo=False):
    """Universal command runner with error handling."""
    if sudo: cmd = ['sudo'] + cmd
    try:
        res = subprocess.run(cmd, capture_output=True, text=True, check=True)
        return res.stdout.strip()
    except Exception as e:
        return f"ERROR: {str(e)}"

@mcp.tool()
def system_telemetry():
    """Hardware health: Thermals, GPU load, Battery, and RAM."""
    temps = psutil.sensors_temperatures()
    t = temps.get('coretemp', [None])[0]
    b = psutil.sensors_battery()
    smi = run_sys_cmd(['nvidia-smi', '--query-gpu=utilization.gpu,temperature.gpu', '--format=csv,noheader'])
    return {
        "cpu_temp": f"{t.current}°C" if t else "N/A",
        "battery": f"{b.percent}%" if b else "AC",
        "ram": f"{psutil.virtual_memory().percent}%",
        "gpu": smi if "ERROR" not in smi else "No NVIDIA GPU",
        "akmod_status": "Rebuilding" if "akmods" in run_sys_cmd(['ps', 'aux']) else "Idle"
    }

@mcp.tool()
def maintenance_suite(action: str = "check"):
    """DNF/Flatpak upgrades and system grooming."""
    if action == "check":
        return run_sys_cmd(['dnf', 'check-update'])
    if action == "upgrade":
        d = run_sys_cmd(['dnf', 'upgrade', '-y'], sudo=True)
        f = run_sys_cmd(['flatpak', 'update', '-y'], sudo=True)
        c = run_sys_cmd(['flatpak', 'uninstall', '--unused', '-y'], sudo=True)
        return f"DNF: {d}\nFlatpak: {f}\nClean: {c}"

@mcp.tool()
def sentinel_scan():
    """Security audit of SSH and Firewall logs."""
    ssh = run_sys_cmd(['journalctl', '-t', 'sshd', '--since', '1h ago', '-g', 'Failed|Invalid'])
    fw = run_sys_cmd(['journalctl', '-k', '--since', '1h ago', '-g', 'FINAL_REJECT|FINAL_DROP'])
    return f"SECURITY REPORT:\nSSH: {ssh}\nFW: {fw}"

@mcp.tool()
def remediate_intrusion(ip: str):
    """Blocks an IP via firewalld for 24h."""
    return run_sys_cmd(['firewall-cmd', '--add-rich-rule', f'rule family="ipv4" source address="{ip}" reject', '--timeout=86400'], sudo=True)

@mcp.tool()
def verify_self_integrity():
    """Self-healing check against the Gold Seed."""
    res = []
    for f in ['server.py', 'mcp-config.json']:
        if not os.path.exists(f"/home/sgallego/mcp-rhel-manager/{f}"):
            subprocess.run(['cp', f'/home/sgallego/.local/share/mcp-seed/{f}.gold', f'/home/sgallego/mcp-rhel-manager/{f}'])
            res.append(f"Restored {f}")
    return "\n".join(res) if res else "Integrity Verified."

if __name__ == "__main__":
    mcp.run()
EOF

echo "⚙️ Phase 4: Configuring Bridge & Sentinel Agent..."
cat << 'EOF' > "$BASE_DIR/mcp-config.json"
{
  "mcpServers": {
    "rhel-manager": {
      "command": "/home/sgallego/mcp-rhel-manager/venv/bin/python",
      "args": ["/home/sgallego/mcp-rhel-manager/server.py"]
    }
  }
}
EOF

cat << 'EOF' > "$BASE_DIR/auto-fixer.sh"
#!/bin/bash
while true; do
  curl -s -X POST http://localhost:1776/api/chat -H "Content-Type: application/json" -d '{
    "model": "qwen2.5-coder:7b",
    "messages": [
      {"role": "system", "content": "You are a RHEL Sentinel. 1. Run sentinel_scan and system_telemetry. 2. If threats found, identify IP. 3. If everything is fine, respond: SYSTEM_OPTIMAL."},
      {"role": "user", "content": "Routine check."}
    ]
  }' >> /home/sgallego/mcp-rhel-manager/sentinel.log
  sleep 600
done
EOF
chmod +x "$BASE_DIR/auto-fixer.sh"

echo "🛡️ Phase 5: Hardening the Gold Seed..."
mkdir -p "$SEED_DIR"
cp "$BASE_DIR/server.py" "$SEED_DIR/server.py.gold"
cp "$BASE_DIR/mcp-config.json" "$SEED_DIR/mcp-config.json.gold"
sudo chattr +i "$SEED_DIR/server.py.gold" "$SEED_DIR/mcp-config.json.gold"

echo "📡 Phase 6: Deploying Systemd User Services..."
mkdir -p ~/.config/systemd/user/

cat << EOF > ~/.config/systemd/user/mcp-bridge.service
[Unit]
Description=Ollama MCP Bridge
After=network.target

[Service]
ExecStart=$BRIDGE_VENV/bin/python -m ollama_mcp_bridge.main --config $BASE_DIR/mcp-config.json --port 1776
Restart=always
EOF

cat << EOF > ~/.config/systemd/user/mcp-sentinel.service
[Unit]
Description=MCP Sentinel Agent
After=mcp-bridge.service

[Service]
ExecStart=$BASE_DIR/auto-fixer.sh
Restart=always
EOF

echo "🚀 Phase 7: Launching..."
sudo firewall-cmd --set-log-denied=all
systemctl --user daemon-reload
systemctl --user enable --now mcp-bridge.service mcp-sentinel.service
sudo loginctl enable-linger sgallego

echo "=============================================================================="
echo "✅ DEPLOYMENT COMPLETE"
echo "Monitor logs: tail -f $LOG_FILE"
echo "Check health: curl http://localhost:1776/health"
echo "=============================================================================="
