{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "MCP Remediation Schema",
    "type": "object",
    "oneOf": [
        {
            "required": [
                "solutions"
            ]
        },
        {
            "required": [
                "commands"
            ]
        }
    ],
    "properties": {
        "solutions": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "commands": {
                        "type": "array",
                        "items": {
                            "oneOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "object"
                                }
                            ]
                        }
                    },
                    "rollback": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "explanation": {
                        "type": "string"
                    },
                    "confidence": {
                        "type": "number"
                    }
                },
                "required": [
                    "commands"
                ]
            }
        },
        "commands": {
            "type": "array",
            "items": {
                "oneOf": [
                    {
                        "type": "string"
                    },
                    {
                        "type": "object"
                    }
                ]
            }
        },
        "explanation": {
            "type": "string"
        },
        "confidence": {
            "type": "number"
        }
    }
}
